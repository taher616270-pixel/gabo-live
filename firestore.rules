rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email == 'taher616380@gmail.com';
    }

    function isAdmin() {
      return isAdminEmail()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true);
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function communityPath(communityId) {
      return /databases/$(database)/documents/communities/$(communityId);
    }

    function communityExists(communityId) {
      return exists(communityPath(communityId));
    }

    function isCommunityOwner(communityId) {
      return signedIn() && communityExists(communityId)
        && get(communityPath(communityId)).data.get('ownerUid', '') == request.auth.uid;
    }

    function isCommunityMember(communityId) {
      return signedIn() && communityExists(communityId)
        && get(communityPath(communityId)).data.get('members', []).hasAny([request.auth.uid]);
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/privateChats/$(chatId);
    }

    function isChatParticipant(chatId) {
      return signedIn() && exists(chatPath(chatId))
        && get(chatPath(chatId)).data.get('participants', []).hasAny([request.auth.uid]);
    }

    function validNotificationSettings(data) {
      return data is map
        && data.keys().hasOnly(['like', 'comment', 'follow', 'dm', 'live', 'master', 'updatedAt'])
        && data.get('like', true) is bool
        && data.get('comment', true) is bool
        && data.get('follow', true) is bool
        && data.get('dm', true) is bool
        && data.get('live', true) is bool
        && data.get('master', true) is bool;
    }

    function validUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'displayName', 'photo', 'photoURL', 'avatar',
          'createdAt', 'banned', 'firstName', 'lastName', 'country', 'countryName',
          'countryFlagImg', 'followers', 'following', 'followersList', 'followingList',
          'visitors', 'gaboId', 'bio', 'gender', 'bday', 'notifications',
          'joinedCommunityIds', 'cover'
        ])
        && request.resource.data.get('uid', userId) == userId
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('displayName', '') is string
        && (!request.resource.data.keys().hasAny(['email'])
          || request.resource.data.email == request.auth.token.email)
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp)
        && (!request.resource.data.keys().hasAny(['followers'])
          || request.resource.data.followers is int)
        && (!request.resource.data.keys().hasAny(['following'])
          || request.resource.data.following is int);
    }

    function validProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'name', 'displayName', 'bio', 'bday', 'gender',
          'country', 'countryName', 'countryFlagImg',
          'photo', 'photoURL', 'avatar', 'cover',
          'deactivated', 'notifications', 'joinedCommunityIds',
          'subPlan', 'subUpdated', 'subPlanRequest', 'subRequestedAt',
          'firstName', 'lastName'
        ])
        && (!changed.hasAny(['deactivated']) || request.resource.data.deactivated == true)
        && (!changed.hasAny(['notifications']) || validNotificationSettings(request.resource.data.notifications))
        && (!changed.hasAny(['subPlan']) || request.resource.data.subPlan == 'free')
        && (!changed.hasAny(['subPlanRequest']) || request.resource.data.subPlanRequest in ['vip', 'pro'])
        && (!changed.hasAny(['joinedCommunityIds'])
          || (request.resource.data.joinedCommunityIds is list
            && request.resource.data.joinedCommunityIds.size() <= 300));
    }

    function validFollowingUpdate() {
      let oldList = resource.data.get('followingList', []);
      let newList = request.resource.data.get('followingList', []);
      let oldCount = resource.data.get('following', oldList.size());
      return oldList is list && newList is list && oldCount is int
        && newList.size() == oldList.size() + 1
        && newList.hasAll(oldList)
        && newList.size() <= 5000
        && request.resource.data.get('following', -1) == oldCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingList', 'following']);
    }

    function validFollowersUpdate() {
      let oldList = resource.data.get('followersList', []);
      let newList = request.resource.data.get('followersList', []);
      let oldCount = resource.data.get('followers', oldList.size());
      return oldList is list && newList is list && oldCount is int
        && newList.size() == oldList.size() + 1
        && newList.hasAll(oldList)
        && !oldList.hasAny([request.auth.uid])
        && newList.hasAny([request.auth.uid])
        && newList.size() <= 5000
        && request.resource.data.get('followers', -1) == oldCount + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersList', 'followers']);
    }

    function validCommunityCreate(communityId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'category', 'rules', 'flag', 'img',
          'ownerUid', 'visibility', 'members', 'membersCount', 'banned',
          'closed', 'joinsToday', 'joinsDay', 'inviteJoins',
          'activityScore', 'activityDay', 'createdAt', 'type'
        ])
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 180
        && request.resource.data.get('category', '') is string
        && request.resource.data.get('rules', '') is string
        && request.resource.data.get('rules', '').size() <= 500
        && request.resource.data.get('flag', '') is string
        && (request.resource.data.get('img', null) == null
          || (request.resource.data.img is string && request.resource.data.img.size() <= 350000))
        && request.resource.data.get('visibility', 'public') in ['public', 'private']
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.membersCount == 1
        && request.resource.data.get('closed', false) == false
        && request.resource.data.get('joinsToday', 0) is int
        && request.resource.data.get('joinsDay', '') is string
        && request.resource.data.get('activityScore', 0) is int
        && request.resource.data.createdAt is timestamp;
    }

    function validCommunityMemberChange(communityId) {
      let oldMembers = resource.data.get('members', []);
      let newMembers = request.resource.data.get('members', []);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let addedSelf = oldMembers is list && newMembers is list
        && newMembers.size() == oldMembers.size() + 1
        && newMembers.hasAll(oldMembers)
        && newMembers.hasAny([request.auth.uid])
        && !oldMembers.hasAny([request.auth.uid]);
      let removedSelf = oldMembers is list && newMembers is list
        && newMembers.size() + 1 == oldMembers.size()
        && oldMembers.hasAll(newMembers)
        && oldMembers.hasAny([request.auth.uid])
        && !newMembers.hasAny([request.auth.uid]);
      return (addedSelf && resource.data.get('visibility', 'public') == 'public' || removedSelf)
        && request.resource.data.get('membersCount', -1) == newMembers.size()
        && changed.hasOnly([
          'members', 'membersCount', 'joinsToday', 'joinsDay',
          'activityScore', 'activityDay', 'name', 'type'
        ])
        && (!changed.hasAny(['name'])
          || (communityId == 'global' && request.resource.data.name == 'الشات العام'))
        && (!changed.hasAny(['type'])
          || request.resource.data.type == (communityId == 'global' ? 'public-chat' : 'community'))
        && request.resource.data.get('joinsToday', 0) is int
        && request.resource.data.get('joinsDay', '') is string
        && request.resource.data.get('activityScore', 0) is int
        && request.resource.data.get('activityDay', '') is string;
    }

    function validCommunityMessage() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'text', 'uid', 'displayName', 'name', 'photoURL', 'avatar',
          'photo', 'verified', 'createdAt', 'type'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(['verified'])
          || (exists(userPath(request.auth.uid))
            && request.resource.data.verified == get(userPath(request.auth.uid)).data.get('verified', false)))
        && (request.resource.data.get('photoURL', '') is string
          && request.resource.data.get('photoURL', '').size() <= 350000);
    }

    function validPrivateChatCreate(chatId) {
      let participants = request.resource.data.get('participants', []);
      return signedIn()
        && participants is list
        && participants.size() == 2
        && participants.hasAny([request.auth.uid])
        && participants[0] != participants[1]
        && exists(userPath(participants[0]))
        && exists(userPath(participants[1]))
        && (chatId == participants[0] + '_' + participants[1]
          || chatId == participants[1] + '_' + participants[0])
        && request.resource.data.get('createdAt', null) is timestamp
        && request.resource.data.get('lastAt', null) is timestamp
        && request.resource.data.get('lastText', '') is string
        && request.resource.data.get('unread', {}) is map
        && request.resource.data.get('unread', {}).keys().hasOnly(participants);
    }

    function validPrivateChatUpdate(chatId) {
      let participants = resource.data.get('participants', []);
      return signedIn()
        && participants is list
        && participants.hasAny([request.auth.uid])
        && request.resource.data.get('participants', []) == participants
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('lastAt', null) is timestamp
        && request.resource.data.get('lastText', '') is string
        && request.resource.data.get('lastText', '').size() <= 2000
        && request.resource.data.get('unread', {}) is map
        && request.resource.data.get('unread', {}).keys().hasOnly(participants)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'lastAt', 'createdAt', 'lastText', 'unread'
        ]);
    }

    // User profiles, follows and subscription request flags.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if validUserCreate(userId);
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isAdmin', 'subscription', 'subPlan', 'subUntil', 'banned', 'verified',
          'subPlanRequest', 'subRequestedAt'
        ]))
        || (isSelf(userId) && validProfileUpdate())
        || (isSelf(userId) && validFollowingUpdate())
        || (signedIn() && request.auth.uid != userId && validFollowersUpdate());
      allow delete: if isSelf(userId) || isAdmin();
    }

    // Communities: public metadata is visible to signed-in users; private messages stay member-only.
    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if isAdmin() || validCommunityCreate(communityId);
      allow update: if
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'flag', 'type', 'description'
        ]))
        || (isCommunityOwner(communityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'closed', 'updatedAt', 'messagesToday', 'activityScore',
            'activityDay', 'lastActivityAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['closed'])
            || request.resource.data.closed is bool))
        || (isCommunityMember(communityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'messagesToday', 'activityScore', 'activityDay', 'lastActivityAt'
          ]))
        || (signedIn() && validCommunityMemberChange(communityId));
      allow delete: if isAdmin() || isCommunityOwner(communityId);

      match /messages/{messageId} {
        allow read: if signedIn() && communityExists(communityId)
          && (get(communityPath(communityId)).data.get('visibility', 'public') != 'private'
            || isCommunityMember(communityId) || isCommunityOwner(communityId) || isAdmin());
        allow create: if communityExists(communityId) && validCommunityMessage()
          && (communityId == 'global'
            || isCommunityMember(communityId) || isCommunityOwner(communityId));
        allow update: if false;
        allow delete: if isAdmin() || isCommunityOwner(communityId)
          || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      }

      match /members/{memberUid} {
        allow read: if isAdmin() || isCommunityOwner(communityId)
          || (signedIn() && memberUid == request.auth.uid);
        allow create: if isAdmin() || isCommunityOwner(communityId)
          || (signedIn() && memberUid == request.auth.uid && isCommunityMember(communityId));
        allow update: if false;
        allow delete: if isAdmin() || isCommunityOwner(communityId)
          || (signedIn() && memberUid == request.auth.uid);
      }
    }

    // Direct messages: both participants are fixed at chat creation.
    match /privateChats/{chatId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get('participants', []).hasAny([request.auth.uid]));
      allow create: if validPrivateChatCreate(chatId);
      allow update: if validPrivateChatUpdate(chatId);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('participants', []).hasAny([request.auth.uid]));

      match /messages/{messageId} {
        allow read: if isAdmin() || isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasOnly(['text', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isAdmin()
          || (isChatParticipant(chatId) && resource.data.get('uid', '') == request.auth.uid);
      }
    }

    // Host applications created by signed-in users.
    match /hosts/{hostId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'city', 'details', 'uid', 'approved', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('details', '') is string
        && request.resource.data.get('details', '').size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'approvedAt'])
        && request.resource.data.approved is bool;
      allow delete: if isAdmin();
    }

    // Legacy public host form retained without exposing application reads.
    match /hostRegistrations/{registrationId} {
      allow create: if request.resource.data.keys().hasOnly([
          'fullName', 'email', 'country', 'phone', 'whatsapp',
          'consent', 'emailUpdatesConsent', 'status', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.get('consent', false) == true
        && request.resource.data.get('emailUpdatesConsent', false) is bool
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Public site configuration. Never store secrets or private payment credentials here.
    match /site_config/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Country registry images are compressed data URLs stored in Firestore, not Firebase Storage.
    match /country_registry/{countryCode} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'flag'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.flag is string
        && request.resource.data.flag.size() <= 350000;
      allow delete: if isAdmin();
    }

    match /country_registry_meta/{documentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['disabledCodes', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('disabledCodes', []) is list
        && request.resource.data.get('updatedBy', request.auth.uid) == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Main app currently stores notification preferences on users/{uid}; this is for inbox items.
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('recipientUid', '') == request.auth.uid));
      allow create: if isAdmin();
      allow update: if signedIn()
        && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('recipientUid', '') == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.get('read', false) is bool;
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('recipientUid', '') == request.auth.uid));
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'type', 'message', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('message', '') is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.get('status', 'new') == 'new';
      allow read: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'plan', 'status', 'createdAt', 'note'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.plan in ['vip', 'pro']
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.get('note', '') is string;
      allow read: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, update, delete: if isAdmin();
    }

    match /follows/{followId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.get('followerUid', '') == request.auth.uid
          || resource.data.get('followingUid', '') == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && exists(userPath(request.resource.data.followingUid))
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('followerUid', '') == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'userId', 'text', 'caption', 'image', 'imageUrl', 'videoUrl',
          'mediaUrl', 'type', 'visibility', 'createdAt', 'likesCount', 'commentsCount'
        ])
        && (request.resource.data.get('uid', '') == request.auth.uid
          || request.resource.data.get('userId', '') == request.auth.uid)
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'caption', 'updatedAt']);
      allow delete: if isAdmin()
        || (signedIn() && (resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid));

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn() && likeUid == request.auth.uid
          && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'name', 'photoURL'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
      }
    }

    // Legacy top-level messages used by the old shared chat module.
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'communityId', 'from', 'fromName', 'name', 'text', 'createdAt'
        ])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.communityId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.get('from', '') == request.auth.uid);
    }

    // Voice rooms are intentionally disabled in the current GABO LIVE build.
    match /voiceRooms/{roomId} {
      allow read, write: if false;
    }

    // No unlisted path is readable or writable by clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}