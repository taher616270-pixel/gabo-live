rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'taher616380@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validText(value, maxLength) { return value is string && value.size() <= maxLength; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','name','displayName','email','photo','photoURL','avatar','cover','bio','country','countryName','countryFlagImg','gender','bday','gaboId','createdAt']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','displayName','photo','photoURL','avatar','cover','bio','country','countryName','countryFlagImg','gender','bday']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','text','image','images','createdAt','likesCount','commentsCount']);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','image','images']));
      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && validText(request.resource.data.text,2000);
        allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerUid == request.auth.uid && request.resource.data.followingUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /communities/{communityId} {
      function isPublic() {
        return !('visibility' in resource.data) || resource.data.visibility == 'public';
      }
      function canAccess() {
        return signedIn() && (isPublic()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.members is list && request.auth.uid in resource.data.members));
      }
      function validInvite(token) {
        return token is string
          && exists(/databases/$(database)/documents/communities/$(communityId)/invites/$(token))
          && get(/databases/$(database)/documents/communities/$(communityId)/invites/$(token)).data.active == true
          && get(/databases/$(database)/documents/communities/$(communityId)/invites/$(token)).data.communityId == communityId;
      }
      function memberAddedExactlyOnce() {
        return request.resource.data.members is list
          && resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.membersCount == resource.data.membersCount + 1
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.uid == request.auth.uid;
      }
      function publicJoin() {
        return signedIn()
          && (!('visibility' in resource.data) || resource.data.visibility == 'public')
          && memberAddedExactlyOnce()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','membersCount']);
      }
      function privateInviteJoin() {
        return signedIn()
          && resource.data.visibility == 'private'
          && memberAddedExactlyOnce()
          && request.resource.data.inviteJoins == resource.data.inviteJoins + 1
          && request.resource.data.lastInviteToken is string
          && validInvite(request.resource.data.lastInviteToken)
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.inviteToken == request.resource.data.lastInviteToken
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','membersCount','inviteJoins','lastInviteToken']);
      }

      allow get, list: if canAccess();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.visibility in ['public','private'];
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid) || publicJoin() || privateInviteJoin();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /messages/{messageId} {
        function parentPublic() {
          let parent = get(/databases/$(database)/documents/communities/$(communityId));
          return !('visibility' in parent.data) || parent.data.visibility == 'public';
        }
        function parentMember() {
          let parent = get(/databases/$(database)/documents/communities/$(communityId));
          return signedIn() && (parent.data.ownerUid == request.auth.uid
            || (parent.data.members is list && request.auth.uid in parent.data.members));
        }
        allow read: if signedIn() && (parentPublic() || parentMember());
        allow create: if signedIn() && (parentPublic() || parentMember())
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.text,3000);
        allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /members/{uid} {
        function parentData() { return get(/databases/$(database)/documents/communities/$(communityId)).data; }
        function parentIsPublic() { return !('visibility' in parentData()) || parentData().visibility == 'public'; }
        allow read: if signedIn() && (isOwner(uid) || parentData().ownerUid == request.auth.uid
          || parentIsPublic() || (parentData().members is list && request.auth.uid in parentData().members));
        allow create: if signedIn() && request.resource.data.uid == uid
          && (parentData().ownerUid == request.auth.uid
            || (isOwner(uid) && (parentIsPublic()
              || (parentData().members is list && request.auth.uid in parentData().members)
              || validInvite(request.resource.data.inviteToken))));
        allow update, delete: if isAdmin() || (signedIn() && parentData().ownerUid == request.auth.uid);
      }

      match /invites/{token} {
        function parentData() { return get(/databases/$(database)/documents/communities/$(communityId)).data; }
        allow get: if signedIn();
        allow list: if signedIn() && parentData().ownerUid == request.auth.uid;
        allow create: if signedIn() && parentData().ownerUid == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.active == true;
        allow update: if isAdmin() || parentData().ownerUid == request.auth.uid
          || (signedIn()
            && resource.data.active == true
            && request.resource.data.uses == resource.data.uses + 1
            && getAfter(/databases/$(database)/documents/communities/$(communityId)).data.members.hasAny([request.auth.uid])
            && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.inviteToken == token
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']));
        allow delete: if isAdmin() || (signedIn() && parentData().ownerUid == request.auth.uid);
      }

      match /joins/{uid} {
        function parentData() { return get(/databases/$(database)/documents/communities/$(communityId)).data; }
        allow read: if signedIn() && (parentData().ownerUid == request.auth.uid
          || (parentData().members is list && request.auth.uid in parentData().members));
        allow create: if isOwner(uid) && request.resource.data.uid == uid
          && request.resource.data.dayKey is string
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/members/$(uid)).data.uid == uid;
        allow update, delete: if isAdmin() || (signedIn() && parentData().ownerUid == request.auth.uid);
      }

      match /presence/{uid} {
        function parentData() { return get(/databases/$(database)/documents/communities/$(communityId)).data; }
        function memberCanSee() { return parentData().ownerUid == request.auth.uid
          || (parentData().members is list && request.auth.uid in parentData().members); }
        allow read: if signedIn() && (memberCanSee() || !('visibility' in parentData()) || parentData().visibility == 'public');
        allow create, update: if isOwner(uid) && request.resource.data.uid == uid && memberCanSee();
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    match /privateChats/{chatId} {
      function isParticipant() { return signedIn() && request.auth.uid in resource.data.participants; }
      allow read: if isParticipant();
      allow create: if signedIn() && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant() && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt','lastText','unread']);
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function chatParticipant() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants; }
        allow read: if chatParticipant();
        allow create: if chatParticipant() && request.resource.data.uid == request.auth.uid && validText(request.resource.data.text,5000);
        allow update, delete: if isAdmin() || (chatParticipant() && resource.data.uid == request.auth.uid);
      }
    }

    match /hosts/{hostId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }
    match /subscription_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }
    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /site_config/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /country_registry/{countryCode} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /country_registry_meta/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}