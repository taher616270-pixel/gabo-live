rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'taher616380@gmail.com' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
      );
    }

    // أعلام الدول: القراءة عامة، والرفع/التعديل للإدارة فقط.
    match /country-flags/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        fileName.matches('^[a-z0-9-]+\\.jpg$') &&
        request.resource.size < 1 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}